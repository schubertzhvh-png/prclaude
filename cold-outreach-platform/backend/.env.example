# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cold_outreach"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Instagram (encrypted storage)
# Generate with: openssl rand -hex 32
INSTAGRAM_ENCRYPTION_KEY=your-32-char-key-here-replace-this-value

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...

# Rate Limits (Instagram DM)
MAX_DM_PER_HOUR=20
MAX_DM_PER_DAY=100
MIN_DELAY_BETWEEN_DM=45
MAX_DELAY_BETWEEN_DM=180

# Active Hours (24h format)
ACTIVE_START_HOUR=9
ACTIVE_END_HOUR=21
