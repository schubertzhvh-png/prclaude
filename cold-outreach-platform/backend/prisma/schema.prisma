// Prisma Schema для Cold Outreach Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum Platform {
  instagram
  x
}

enum CampaignStatus {
  draft
  active
  paused
  completed
}

enum LeadStatus {
  new
  messaged
  replied
  booked
  lost
}

enum LeadSource {
  followers
  following
  likes
  comments
  manual
  import
  other
}

enum MessageJobStatus {
  pending
  sent
  failed
  cancelled
}

enum MessageChannel {
  manual
  instagram_auto
  x_auto
}

enum ConversationDirection {
  outbound
  inbound
}

enum InstagramImportType {
  followers
  following
  likers
  commenters
}

// ========================================
// MODELS
// ========================================

model User {
  id              String   @id @default(uuid())
  email           String?  @unique
  passwordHash    String?  @map("password_hash")
  name            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  campaigns          Campaign[]
  instagramAccounts  InstagramAccount[]

  @@index([email])
  @@map("User")
}

model Campaign {
  id          String         @id @default(uuid())
  userId      String?        @map("user_id")
  name        String
  description String?
  platform    Platform
  niche       String?
  offer       String?        @db.Text
  aiContext   String?        @map("ai_context") @db.Text
  status      CampaignStatus @default(draft)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  user               User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads              Lead[]
  sequence           Sequence?
  messageJobs        MessageJob[]
  importedSources    InstagramImportedSource[]

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("Campaign")
}

model Lead {
  id                  String      @id @default(uuid())
  campaignId          String      @map("campaign_id")
  username            String
  platform            Platform
  name                String?
  niche               String?
  note                String?     @db.Text
  source              LeadSource  @default(manual)
  status              LeadStatus  @default(new)
  currentStepIndex    Int         @default(0) @map("current_step_index")
  lastMessage         String?     @map("last_message") @db.Text
  lastInteractionAt   DateTime?   @map("last_interaction_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  // Relations
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messageJobs        MessageJob[]
  conversationLogs   ConversationLog[]

  @@unique([campaignId, username, platform])
  @@index([campaignId])
  @@index([status])
  @@index([platform])
  @@index([source])
  @@index([currentStepIndex])
  @@index([username])
  @@index([lastInteractionAt(sort: Desc)])
  @@index([campaignId, status, currentStepIndex])
  @@index([campaignId, platform])
  @@map("Lead")
}

model Sequence {
  id          String   @id @default(uuid())
  campaignId  String   @unique @map("campaign_id")
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  campaign  Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  steps     SequenceStep[]

  @@index([campaignId])
  @@map("Sequence")
}

model SequenceStep {
  id              String   @id @default(uuid())
  sequenceId      String   @map("sequence_id")
  stepIndex       Int      @map("step_index")
  title           String
  messageTemplate String   @map("message_template") @db.Text
  delayDays       Int      @default(0) @map("delay_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  sequence  Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stepIndex])
  @@index([sequenceId])
  @@index([stepIndex])
  @@map("SequenceStep")
}

model MessageJob {
  id           String           @id @default(uuid())
  leadId       String           @map("lead_id")
  campaignId   String           @map("campaign_id")
  stepIndex    Int              @map("step_index")
  messageText  String           @map("message_text") @db.Text
  plannedAt    DateTime         @map("planned_at")
  sentAt       DateTime?        @map("sent_at")
  status       MessageJobStatus @default(pending)
  errorMessage String?          @map("error_message") @db.Text
  channel      MessageChannel   @default(manual)
  retryCount   Int              @default(0) @map("retry_count")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([campaignId])
  @@index([status])
  @@index([plannedAt])
  @@index([channel])
  @@index([stepIndex])
  @@index([status, plannedAt])
  @@map("MessageJob")
}

model ConversationLog {
  id             String                @id @default(uuid())
  leadId         String                @map("lead_id")
  direction      ConversationDirection
  messageSnippet String                @map("message_snippet") @db.Text
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  // Relations
  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt(sort: Desc)])
  @@index([direction])
  @@map("ConversationLog")
}

model InstagramAccount {
  id                      String    @id @default(uuid())
  userId                  String?   @map("user_id")
  isActive                Boolean   @default(true) @map("is_active")
  username                String
  sessionCookieEncrypted  String?   @map("session_cookie_encrypted") @db.Text
  sessionDataEncrypted    String?   @map("session_data_encrypted") @db.Text
  lastUsedAt              DateTime? @map("last_used_at")
  dailyDmSent             Int       @default(0) @map("daily_dm_sent")
  dailyDmResetAt          DateTime  @default(now()) @map("daily_dm_reset_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("InstagramAccount")
}

model InstagramImportedSource {
  id            String              @id @default(uuid())
  campaignId    String              @map("campaign_id")
  igType        InstagramImportType @map("ig_type")
  igTarget      String              @map("ig_target") @db.VarChar(500)
  leadsImported Int                 @default(0) @map("leads_imported")
  importedAt    DateTime            @default(now()) @map("imported_at")

  // Relations
  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([igType])
  @@index([importedAt(sort: Desc)])
  @@map("InstagramImportedSource")
}
