# Miro API Configuration
# Get your access token from: https://miro.com/app/settings/user-profile/apps

# Required: Your Miro access token
MIRO_ACCESS_TOKEN=your_miro_access_token_here

# Optional: Use existing board instead of creating new one
# Get Board ID from URL: https://miro.com/app/board/uXjVKME_rQw=/
#MIRO_BOARD_ID=

# Example usage:
# 1. Copy this file to .env
# 2. Replace "your_miro_access_token_here" with your actual token
# 3. Run: node miro-integration.js
